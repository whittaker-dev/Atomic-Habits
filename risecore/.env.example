# ===== Cách đăng =====
# DRAFT     = lưu nháp, bạn tự bấm đăng trong Meta Business Suite (an toàn, mặc định)
# PUBLISHED = đăng ngay
# SCHEDULED = hẹn giờ, cần FB_SCHEDULE_AT (ISO, ví dụ 2026-11-03T19:00:00+07:00)
FB_VIDEO_STATE=DRAFT
FB_SCHEDULE_AT=
GRAPH_VERSION=v26.0
