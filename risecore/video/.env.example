# Giọng đọc cho video "Tiếng Anh mỗi ngày" (scripts/make-voice.mjs).
# Điền vào video/.env hoặc risecore/.env (script đọc cả hai).
# Không có ELEVENLABS_API_KEY thì script dùng giọng có sẵn của macOS để xem trước.
ELEVENLABS_API_KEY=
# Không bắt buộc: đổi giọng (ElevenLabs → Voices → chọn giọng → Copy voice ID).
# Bỏ trống thì dùng Liam (Tí) và Jessica (Mia). Gói Free chỉ gọi API được giọng premade.
ELEVENLABS_VOICE_TI=
ELEVENLABS_VOICE_MIA=
ELEVENLABS_MODEL=eleven_multilingual_v2
